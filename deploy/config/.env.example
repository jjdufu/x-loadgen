# x-loadgen 部署配置模板。首次执行任一脚本时复制为 config/.env（600，不入库），之后只改 config/.env。
# STACK 决定容器名 / compose 工程名 / 网络名前缀：${STACK}-x-loadgen、${STACK}-x-loadgen-net
STACK=mazbri
TZ=Asia/Shanghai

# 镜像 ${X_LOADGEN_IMAGE}:${X_LOADGEN_VERSION}
#   dex2all/x-loadgen = Docker Hub 发版镜像（linux/amd64 + arm64），本机没有时 start.sh 自动 docker pull
#   x-loadgen         = 在仓库根本地构建的镜像（docker build -t x-loadgen:<版本> .），离线主机 docker load
X_LOADGEN_IMAGE=dex2all/x-loadgen
X_LOADGEN_VERSION=0.1.0

# 宿主机端口发布：'${X_LOADGEN_BIND}:${X_LOADGEN_PORT}:8757'（容器内固定监听 0.0.0.0:8757）
#   0.0.0.0   = 局域网可访问（默认）
#   127.0.0.1 = 只开本机
X_LOADGEN_BIND=0.0.0.0
X_LOADGEN_PORT=8757
# 打印访问地址用的主机名或 IP；留空时自动探测本机内网 IP（ip route src -> hostname -I -> 127.0.0.1）
X_LOADGEN_ACCESS_HOST=

# 鉴权：0 = 开启（首次启动在 data/admin.passwd 生成随机口令）；1 = 关闭登录（仅联调）
X_LOADGEN_NO_AUTH=0
# 全局硬上限（所有运行中任务合计），留空表示不限
X_LOADGEN_MAX_QPS=
X_LOADGEN_MAX_CONCURRENCY=

# 规格档位（压测机按 CPU 核数调整）：
#   标准:  LG_CPUS=4  LG_MEM=4G   LG_CPUS_RESERVE=0.5 LG_MEM_RESERVE=256M
#   高配:  LG_CPUS=16 LG_MEM=16G  LG_CPUS_RESERVE=4   LG_MEM_RESERVE=2G
LG_CPUS=4
LG_MEM=4G
LG_CPUS_RESERVE=0.5
LG_MEM_RESERVE=256M
# 高并发连接所需的文件句柄上限
LG_NOFILE=262144

# docker stop 的宽限：停投、排空写库、写检查点；超时被 SIGKILL 才会留下 pending-*.bin
X_LOADGEN_STOP_GRACE=120s

# 备份保留天数（backups/ 下超过天数的备份在下次 backup 时删除）
BACKUP_RETENTION_DAYS=7
